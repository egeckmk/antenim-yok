<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AntenimYok.App.MiniPlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AntenimYok.App.Controls"
    Title="Antenim Yok">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RowDefinitions="32,*">
        <!--  Drag area; caption (close) button sits on the right  -->
        <Grid x:Name="DragArea" Padding="12,0,48,0">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Antenim Yok" />
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="12,0,12,12"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="12">
            <controls:StationLogo
                Width="64"
                Height="64"
                VerticalAlignment="Top"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                InitialsStyle="{StaticResource SubtitleTextBlockStyle}"
                Item="{x:Bind ViewModel.CurrentItem, Mode=OneWay}" />

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.StationName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Grid.Row="1"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.NowPlayingDetail, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.NowPlayingDetail, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />

                <Grid
                    Grid.Row="2"
                    Margin="0,4,0,0"
                    ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                    <Button
                        AutomationProperties.Name="Önceki istasyon"
                        Command="{x:Bind ViewModel.PlayPreviousCommand}"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Önceki istasyon">
                        <FontIcon Glyph="&#xE892;" />
                    </Button>
                    <Grid Grid.Column="1">
                        <Button
                            AutomationProperties.Name="{x:Bind ViewModel.PlayStopLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.TogglePlaybackCommand}"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.PlayStopLabel, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind ViewModel.PlayStopGlyph, Mode=OneWay}" />
                        </Button>
                        <ProgressRing
                            Width="28"
                            Height="28"
                            IsActive="{x:Bind ViewModel.IsConnecting, Mode=OneWay}"
                            IsHitTestVisible="False" />
                    </Grid>
                    <Button
                        Grid.Column="2"
                        AutomationProperties.Name="Sonraki istasyon"
                        Command="{x:Bind ViewModel.PlayNextCommand}"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Sonraki istasyon">
                        <FontIcon Glyph="&#xE893;" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="{x:Bind ViewModel.MuteLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleMuteCommand}"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.MuteLabel, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.MuteGlyph, Mode=OneWay}" />
                    </Button>
                    <Slider
                        Grid.Column="4"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Ses düzeyi"
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="1"
                        Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
                    <Button
                        Grid.Column="5"
                        AutomationProperties.Name="Ana pencereye dön"
                        Click="OnExpandClick"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Ana pencereye dön">
                        <FontIcon Glyph="&#xEE47;" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
