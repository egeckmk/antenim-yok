<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AntenimYok.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1000"
            Margin="36,24,36,36"
            Spacing="4">
            <TextBlock
                Margin="0,0,0,20"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Ayarlar" />

            <TextBlock
                Margin="0,0,0,4"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Görünüm" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <RadioButtons
                    Header="Tema"
                    MaxColumns="3"
                    SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                    <x:String>Sistem</x:String>
                    <x:String>Açık</x:String>
                    <x:String>Koyu</x:String>
                </RadioButtons>
            </Border>

            <TextBlock
                Margin="0,24,0,4"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Pencere" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Kapatınca tepside çalmaya devam et" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Kapalıysa pencereyi kapatmak uygulamadan çıkar."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        AutomationProperties.Name="Kapatınca tepside çalmaya devam et"
                        IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}"
                        OffContent="Kapalı"
                        OnContent="Açık" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Windows açılınca başlat" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Oturum açınca pencere açmadan tepside başlar; çalmaya kendin başlarsın."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        AutomationProperties.Name="Windows açılınca başlat"
                        IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                        OffContent="Kapalı"
                        OnContent="Açık" />
                </Grid>
            </Border>

            <TextBlock
                Margin="0,24,0,4"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Çalma" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Çalan şarkının adını göster" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Destekleyen istasyonlarda. Şarkı adını okumak için yayına ikinci bir bağlantı açılır; veri kullanımı yaklaşık iki katına çıkar."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        AutomationProperties.Name="Çalan şarkının adını göster"
                        IsOn="{x:Bind ViewModel.ShowSongTitles, Mode=TwoWay}"
                        OffContent="Kapalı"
                        OnContent="Açık" />
                </Grid>
            </Border>

            <TextBlock
                Margin="0,24,0,4"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Klavye kısayolları" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="24"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                    RowSpacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Boşluk" />
                    <TextBlock Grid.Column="1" Text="Çal / durdur" />
                    <TextBlock Grid.Row="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Ctrl + 1…9" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Sıradaki favoriyi çal" />
                    <TextBlock Grid.Row="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Ctrl + F" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="İstasyon ara" />
                    <TextBlock Grid.Row="3" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Ctrl + ↑ / ↓" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Sesi aç / kıs" />
                    <TextBlock Grid.Row="4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="M" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Sessiz" />
                </Grid>
            </Border>

            <TextBlock
                Margin="0,24,0,4"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Hakkında" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Antenim Yok" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.Version}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                        Content="Güncellemeleri denetle"
                        IsEnabled="{x:Bind ViewModel.CanCheckForUpdates}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
