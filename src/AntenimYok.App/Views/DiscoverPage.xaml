<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AntenimYok.App.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AntenimYok.App.Controls"
    xmlns:discovery="using:AntenimYok.Core.Discovery"
    xmlns:vm="using:AntenimYok.App.ViewModels"
    Background="Transparent">

    <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Margin="36,24,36,8">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Keşfet" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
        </StackPanel>

        <!--  Genre chips  -->
        <ListView
            x:Name="GenreList"
            Grid.Row="1"
            Margin="32,0,32,8"
            AutomationProperties.Name="Tür"
            ItemsSource="{x:Bind ViewModel.Genres}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollMode="Enabled"
            ScrollViewer.VerticalScrollMode="Disabled"
            SelectionChanged="OnGenreSelectionChanged"
            SelectionMode="Single">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="discovery:Genre">
                    <TextBlock Text="{x:Bind Name}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ListView
            x:Name="ResultList"
            Grid.Row="2"
            Padding="24,0,24,24"
            AutomationProperties.Name="Bulunan istasyonlar"
            ContainerContentChanging="OnResultContainerContentChanging"
            IsItemClickEnabled="True"
            ItemClick="OnStationClick"
            ItemsSource="{x:Bind ViewModel.Results}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:StationItem">
                    <Grid
                        Padding="0,6"
                        AutomationProperties.Name="{x:Bind Name}"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12">
                        <Grid Width="40" Height="40">
                            <controls:StationLogo
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                InitialsStyle="{StaticResource CaptionTextBlockStyle}"
                                Item="{x:Bind}" />
                            <Border
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="2"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Visibility="{x:Bind IsPlaying, Mode=OneWay}" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Subtitle}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind FavoriteLabel, Mode=OneWay}"
                            Click="OnToggleFavorite"
                            Style="{StaticResource SubtleButtonStyle}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="{x:Bind FavoriteLabel, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  Loading / error / empty  -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <ProgressRing HorizontalAlignment="Center" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="İstasyonlar yükleniyor…" />
        </StackPanel>
        <InfoBar
            Title="İstasyon listesine ulaşılamadı"
            Grid.Row="2"
            Margin="36,0"
            VerticalAlignment="Top"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.LoadFailed, Mode=OneWay}"
            Message="Radio Browser'a bağlanılamadı. İnternet bağlantını kontrol edip tekrar dene."
            Severity="Warning">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind ViewModel.LoadCommand}" Content="Tekrar dene" />
            </InfoBar.ActionButton>
        </InfoBar>
        <TextBlock
            Grid.Row="2"
            Margin="36,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            Text="Bu aramaya uyan istasyon yok."
            Visibility="{x:Bind ViewModel.HasNoResults, Mode=OneWay}" />
    </Grid>
</Page>
