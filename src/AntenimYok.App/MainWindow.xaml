<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AntenimYok.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AntenimYok.App.Controls"
    xmlns:tb="using:H.NotifyIcon"
    Title="Antenim Yok">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        KeyboardAcceleratorPlacementMode="Hidden"
        RowDefinitions="Auto,*,Auto">

        <!--  Tray icon: left click opens the window, right click shows favorites + actions (built in code)  -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            LeftClickCommand="{x:Bind ShowMainWindowCommand}"
            NoLeftClickDelay="True"
            ToolTipText="{x:Bind ViewModel.TrayToolTip, Mode=OneWay}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout x:Name="TrayMenu" />
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Antenim Yok"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
            <AutoSuggestBox
                x:Name="SearchBox"
                MinWidth="240"
                MaxWidth="400"
                VerticalAlignment="Center"
                AutomationProperties.Name="İstasyon ara"
                PlaceholderText="İstasyon ara (Ctrl+F)"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextChanged="OnSearchTextChanged" />
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            PaneDisplayMode="Auto"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Favoriler" Tag="favorites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Keşfet" Tag="discover">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE909;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Ayarlar" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid RowDefinitions="Auto,*">
                <StackPanel Margin="36,16,36,0" Spacing="8">
                    <InfoBar
                        Title="Yayına ulaşılamadı"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        Message="İstasyonun hiçbir akışı açılmadı. İnternet bağlantını kontrol edip tekrar dene ya da başka bir istasyon seç."
                        Severity="Error">
                        <InfoBar.ActionButton>
                            <Button Command="{x:Bind ViewModel.RetryCommand}" Content="Tekrar dene" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar
                        Title="Güncelleme hazır"
                        IsOpen="{x:Bind ViewModel.IsUpdateReady, Mode=OneWay}"
                        Message="{x:Bind ViewModel.UpdateReadyMessage, Mode=OneWay}"
                        Severity="Informational">
                        <InfoBar.ActionButton>
                            <Button Command="{x:Bind ViewModel.RestartToUpdateCommand}" Content="Yeniden başlat" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>

        <!--  Now Playing bar (visible on every page)  -->
        <Grid
            Grid.Row="2"
            Padding="24,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnDefinitions="Auto,*,Auto,Auto,Auto"
            ColumnSpacing="12">

            <controls:StationLogo
                Width="48"
                Height="48"
                CornerRadius="{StaticResource ControlCornerRadius}"
                InitialsStyle="{StaticResource BodyStrongTextBlockStyle}"
                Item="{x:Bind ViewModel.CurrentItem, Mode=OneWay}" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.StationName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.NowPlayingDetail, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.NowPlayingDetail, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>

            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Button
                    Width="44"
                    Height="44"
                    Padding="0"
                    AutomationProperties.Name="{x:Bind ViewModel.PlayStopLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.TogglePlaybackCommand}"
                    CornerRadius="22"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PlayStopLabel, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ViewModel.PlayStopGlyph, Mode=OneWay}" />
                </Button>
                <ProgressRing
                    Width="44"
                    Height="44"
                    IsActive="{x:Bind ViewModel.IsConnecting, Mode=OneWay}"
                    IsHitTestVisible="False" />
            </Grid>

            <StackPanel
                x:Name="VolumePanel"
                Grid.Column="3"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    AutomationProperties.Name="{x:Bind ViewModel.MuteLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ToggleMuteCommand}"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.MuteLabel, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ViewModel.MuteGlyph, Mode=OneWay}" />
                </Button>
                <Slider
                    Width="120"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Ses düzeyi"
                    Maximum="100"
                    Minimum="0"
                    StepFrequency="1"
                    Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
            </StackPanel>

            <Button
                Grid.Column="4"
                VerticalAlignment="Center"
                AutomationProperties.Name="Mini oynatıcı"
                Command="{x:Bind ShowMiniPlayerCommand}"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Mini oynatıcı">
                <FontIcon Glyph="&#xEE49;" />
            </Button>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!--  Narrow window: drop the volume slider (media keys / mute still work)  -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="VolumePanel.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="560" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Window>
