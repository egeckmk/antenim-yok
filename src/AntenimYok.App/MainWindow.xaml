<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AntenimYok.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:stations="using:AntenimYok.Core.Stations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Antenim Yok">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RowDefinitions="Auto,Auto,*,Auto">

        <TextBlock
            Margin="24,16,24,12"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="İstasyonlar" />

        <StackPanel Grid.Row="1" Margin="24,0,24,12" Spacing="8">
            <InfoBar
                Title="Yayına ulaşılamadı"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="İstasyonun hiçbir akışı açılmadı. İnternet bağlantınızı kontrol edip tekrar deneyin ya da başka bir istasyon seçin."
                Severity="Error">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.RetryCommand}" Content="Tekrar dene" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                Title="İstasyon listesi yüklenemedi"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.LoadFailed, Mode=OneWay}"
                Severity="Error">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.LoadCommand}" Content="Tekrar dene" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <GridView
            Grid.Row="2"
            Padding="20,0,20,24"
            AutomationProperties.Name="İstasyonlar"
            IsItemClickEnabled="True"
            ItemClick="OnStationClick"
            ItemsSource="{x:Bind ViewModel.Stations}"
            SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="stations:Station">
                    <StackPanel
                        Width="112"
                        Padding="0,8"
                        AutomationProperties.Name="{x:Bind Name}"
                        Spacing="8"
                        ToolTipService.ToolTip="{x:Bind Name}">
                        <Border
                            Width="96"
                            Height="96"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource OverlayCornerRadius}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind Initials}" />
                        </Border>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!--  Now Playing bar  -->
        <Grid
            Grid.Row="3"
            Padding="24,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="12">

            <Border
                Width="48"
                Height="48"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.StationInitials, Mode=OneWay}" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.StationName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>

            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Button
                    Width="44"
                    Height="44"
                    Padding="0"
                    AutomationProperties.Name="{x:Bind ViewModel.PlayStopLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.TogglePlaybackCommand}"
                    CornerRadius="22"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PlayStopLabel, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ViewModel.PlayStopGlyph, Mode=OneWay}" />
                </Button>
                <ProgressRing
                    Width="44"
                    Height="44"
                    IsActive="{x:Bind ViewModel.IsConnecting, Mode=OneWay}"
                    IsHitTestVisible="False" />
            </Grid>

            <StackPanel
                Grid.Column="3"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    AutomationProperties.Name="{x:Bind ViewModel.MuteLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ToggleMuteCommand}"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.MuteLabel, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ViewModel.MuteGlyph, Mode=OneWay}" />
                </Button>
                <Slider
                    Width="120"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Ses düzeyi"
                    Maximum="100"
                    Minimum="0"
                    StepFrequency="1"
                    Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
